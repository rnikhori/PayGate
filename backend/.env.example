# Copy to backend/.env for local development. These variables are loaded by
# backend/internal/config (optional for local dev via this file; in CI/prod
# they're expected to come from the real environment instead). See
# infra/.env.example for the separate Postgres container credentials used by
# docker-compose.

# Required. Full Postgres DSN. For local dev this matches the defaults in
# infra/.env.example and infra/docker-compose.yml.
DATABASE_URL=postgres://paygate:paygate@localhost:5432/paygate?sslmode=disable

# Required. HMAC-SHA256 secret used to sign outgoing webhooks
# (X-PayGate-Signature header). Use a long random value outside local dev.
WEBHOOK_SIGNING_SECRET=change-me-to-a-random-secret

# Optional. Port the HTTP API listens on. Defaults to 8080.
HTTP_PORT=8080

# Optional. Minimum log level: debug|info|warn|error. Defaults to info.
LOG_LEVEL=info

# Optional. How often the nightly ledger integrity job
# (backend/internal/jobs.Scheduler) re-runs, as a Go duration string (e.g.
# "24h", "30m"). Defaults to 24h.
LEDGER_INTEGRITY_CHECK_INTERVAL=24h
